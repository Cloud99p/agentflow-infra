# AgentFlow Infra - Environment Variables
# Copy this file to .env and fill in your API keys

# DeepSeek API for AI Reasoning
# Get your key at: https://platform.deepseek.com/
# Optional - the dashboard falls back to local rule-based reasoning without it.
DEEPSEEK_API_KEY=sk-your-key-here

# Bitget API (Optional - only needed for account access / order placement)
# Bitget has NO testnet. It uses "Demo Trading" (simulation mode) inside the
# normal account. These keys are not used for market data - prices come from
# CoinGecko/Binance with Bitget only as a last-resort failover.
BITGET_API_KEY=your-bitget-api-key
BITGET_SECRET_KEY=your-bitget-secret-key
BITGET_PASSPHRASE=your-bitget-passphrase

# Dashboard Configuration
DASHBOARD_PORT=3000

# Feature Flags
ENABLE_DEEPSEEK_AI=true
